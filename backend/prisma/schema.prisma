generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  MERCHANT
  ADMIN
}

enum KycStatus {
  NOT_STARTED
  PENDING
  VERIFIED
  REJECTED
}

enum RampType {
  ONRAMP
  OFFRAMP
}

enum RampStatus {
  PENDING_DEPOSIT
  PAYMENT_RECEIVED
  CONVERTING
  SETTLING
  COMPLETED
  FAILED
  CANCELLED
}

model User {
  id            String      @id @default(uuid())
  name          String
  surname       String
  email         String      @unique
  phoneNumber   String      @unique
  walletAddress String      @unique
  role          String      @default("USER")
  kycStatus     KycStatus   @default(NOT_STARTED)
  createdAt     DateTime    @default(now())

  wallet        Wallet? 
  rampOrders    RampOrder[]
}

model Wallet {
  id            String   @id @default(uuid())
  userId        String   @unique
  publicAddress String?  @unique
  chain         String   @default("EVM")
  stablecoin    String   @default("USDC")
  user          User?    @relation(fields: [userId], references: [id])
  balanceCached Decimal  @default(0) @db.Decimal(36, 18)
  createdAt     DateTime @default(now())
}

model Merchant {
  id                   String @id @default(uuid())
  businessName         String
  taxNumber            String
  businessRegistration String
}

model RampOrder {
  id                       String     @id @default(uuid())
  userId                   String?
  user                     User?      @relation(fields: [userId], references: [id])
  type                     RampType
  status                   RampStatus @default(PENDING_DEPOSIT)
  fiatCurrency             String     @default("ZAR")
  fiatAmount               Decimal    @db.Decimal(18, 2)
  cryptoAsset              String     @default("USDC")
  cryptoAmount             Decimal    @db.Decimal(36, 18)
  exchangeRate             Decimal    @db.Decimal(36, 18)
  platformFeeRate          Decimal    @default(0.02) @db.Decimal(6, 4)
  platformFeeZar           Decimal    @db.Decimal(18, 2)
  network                  String     @default("SOL")
  destinationWalletAddress String?
  sourceWalletAddress      String?
  cryptoDepositAddress     String?
  txHash                   String?
  bankName                 String?
  accountNumber            String?
  branchCode               String?
  accountHolderName        String?
  fiatReference            String?    @unique
  valrOrderId              String?
  valrWithdrawalId         String?
  errorMessage             String?
  createdAt                DateTime   @default(now())
  updatedAt                DateTime   @updatedAt
}

model BankAccount {
  id                String   @id @default(uuid())
  userId            String?
  bankName          String
  accountNumber     String
  branchCode        String
  accountType       String   @default("CURRENT")
  accountHolderName String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
