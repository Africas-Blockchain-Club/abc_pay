import "dotenv/config";
import { defineConfig } from "prisma/config";

export default defineConfig({
  schema: "prisma/schema.prisma",
  migrations: {
    path: "prisma/migrations",
  },
  datasource: {
    // Using process.env directly (not the env() helper) so commands like
    // `prisma generate` that don't need a live DB connection still work
    // even before DATABASE_URL is provisioned. Once you have a real
    // Postgres instance (Supabase/Neon per the README), set DATABASE_URL
    // in .env and `prisma db push` / `migrate` will pick it up.
    url: process.env.DATABASE_URL ?? "",
  },
});